{
  "name": "meridian",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 4274",
    "build": "next build",
    "package:usb": "node scripts/package-release.cjs",
    "start": "node scripts/server.cjs out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test tests/e2e/production.spec.ts tests/e2e/meridian.spec.ts tests/e2e/repair.spec.ts tests/e2e/workflow-repair.spec.ts tests/e2e/visa-workflow.spec.ts tests/e2e/visa-documents.spec.ts --grep-invert \"standalone fallback\"",
    "test:e2e:legacy": "playwright test",
    "format": "prettier --write app components lib tests"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
